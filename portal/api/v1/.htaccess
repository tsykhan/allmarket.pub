# allmarket.biz Seller API v1
Options -Indexes
DirectoryIndex index.php

<FilesMatch "^(config|config\.local|bootstrap|cabinet\.inc|cabinet\.view)\.php$|^\.schema">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pass the Authorization header to PHP under CGI/FastCGI/FPM (Plesk).
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^lib/ - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>
