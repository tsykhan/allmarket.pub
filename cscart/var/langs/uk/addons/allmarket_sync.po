msgctxt "SettingsTooltips::allmarket_sync::api_key"
msgid "allmarket.biz cabinet → Integrations → Online store → create a key."
msgstr "Кабінет allmarket.biz → Інтеграції → Інтернет-магазин → створити ключ."

msgctxt "SettingsOptions::allmarket_sync::shop_id"
msgid "Seller ID"
msgstr "ID продавця"

msgctxt "SettingsTooltips::allmarket_sync::shop_id"
msgid "Shown next to the API key in the allmarket.biz cabinet."
msgstr "Показано поруч з API-ключем у кабінеті allmarket.biz."

msgctxt "SettingsOptions::allmarket_sync::info"
msgid "Exchange page"
msgstr "Сторінка обміну"

msgctxt "SettingsOptions::allmarket_sync::lang_code"
msgid "Language of names and descriptions"
msgstr "Мова назв і описів"

msgctxt "SettingsOptions::allmarket_sync::currency"
msgid "Price currency"
msgstr "Валюта цін"

msgctxt "SettingsTooltips::allmarket_sync::currency"
msgid "Prices are converted from the primary currency at the store rate. Use the same currency as in the allmarket.biz cabinet."
msgstr "Ціни перераховуються з основної валюти за курсом магазину. Використовуйте ту саму валюту, що й у кабінеті allmarket.biz."

msgctxt "SettingsOptions::allmarket_sync::categories"
msgid "Export only categories (IDs)"
msgstr "Вивантажувати лише категорії (ID)"

msgctxt "SettingsTooltips::allmarket_sync::categories"
msgid "Comma-separated category IDs, subcategories included. Empty — the whole catalog."
msgstr "ID категорій через кому, разом з підкатегоріями. Порожньо — весь каталог."

msgctxt "SettingsOptions::allmarket_sync::variations"
msgid "Export variations as separate offers"
msgstr "Вивантажувати варіації окремими пропозиціями"

msgctxt "SettingsTooltips::allmarket_sync::variations"
msgid "Variations of one product share group_id and carry their variation features. Off — only parent products."
msgstr "Варіації одного товару мають спільний group_id і свої характеристики варіації. Вимкнено — лише батьківські товари."

msgctxt "SettingsOptions::allmarket_sync::only_in_stock"
msgid "Only products available for order"
msgstr "Лише товари, доступні для замовлення"

msgctxt "SettingsOptions::allmarket_sync::price_markup"
msgid "Price markup, %"
msgstr "Націнка на ціни, %"

msgctxt "SettingsTooltips::allmarket_sync::price_markup"
msgid "Applied to the price and the old price. Negative value — a discount."
msgstr "Застосовується до ціни й старої ціни. Від'ємне значення — знижка."

msgctxt "SettingsOptions::allmarket_sync::batch_size"
msgid "Products per request"
msgstr "Товарів у запиті"

msgctxt "SettingsOptions::allmarket_sync::orders_enabled"
msgid "Import orders"
msgstr "Імпортувати замовлення"

msgctxt "SettingsOptions::allmarket_sync::status_new"
msgid "Status of a new order"
msgstr "Статус нового замовлення"

msgctxt "SettingsOptions::allmarket_sync::status_paid"
msgid "Status of a paid order"
msgstr "Статус оплаченого замовлення"

msgctxt "SettingsOptions::allmarket_sync::shipping_id"
msgid "Shipping method"
msgstr "Спосіб доставки"

msgctxt "SettingsTooltips::allmarket_sync::shipping_id"
msgid "The delivery details from allmarket.biz (city, warehouse) go to the order address and notes."
msgstr "Дані доставки з allmarket.biz (місто, відділення) записуються в адресу та коментар замовлення."

msgctxt "SettingsOptions::allmarket_sync::payment_id"
msgid "Payment method"
msgstr "Спосіб оплати"

msgctxt "SettingsOptions::allmarket_sync::default_country"
msgid "Default country (code)"
msgstr "Країна за замовчуванням (код)"

msgctxt "SettingsOptions::allmarket_sync::use_am_prices"
msgid "Prices from the allmarket.biz order"
msgstr "Ціни із замовлення allmarket.biz"

msgctxt "SettingsTooltips::allmarket_sync::use_am_prices"
msgid "Off — the order uses the current store prices."
msgstr "Вимкнено — у замовленні поточні ціни магазину."

msgctxt "SettingsOptions::allmarket_sync::use_am_shipping"
msgid "Shipping cost from the allmarket.biz order"
msgstr "Вартість доставки із замовлення allmarket.biz"

msgctxt "SettingsOptions::allmarket_sync::notify_customer"
msgid "Notify the customer by e-mail"
msgstr "Сповіщати покупця e-mail"

msgctxt "SettingsOptions::allmarket_sync::notify_admin"
msgid "Notify the order department"
msgstr "Сповіщати відділ замовлень"
