msgid "Category placement"
msgstr "Rozmieszczenie kategorii"

msgctxt "Languages::allmarket_sync_categories_menu_description"
msgid "Where shop categories go on allmarket.biz"
msgstr "Gdzie trafiają kategorie sklepu na allmarket.biz"

msgctxt "Languages::allmarket_sync.task_done"
msgid "Task [task] finished: [stats]"
msgstr "Zadanie [task] zakończone: [stats]"

msgctxt "Languages::allmarket_sync.ping_ok"
msgid "Connected: [name] (ID [id]), seller currency on the portal: [currency]"
msgstr "Połączono: [name] (ID [id]), waluta sprzedawcy na portalu: [currency]"

msgctxt "Languages::allmarket_sync.currency_mismatch"
msgid "Your seller currency on allmarket.biz is [portal], while the add-on exports prices in [shop]. The portal converts them at its rate; set the same currency to avoid differences."
msgstr "Waluta sprzedawcy na allmarket.biz to [portal], a moduł eksportuje ceny w [shop]. Portal przeliczy je po swoim kursie; ustaw tę samą walutę, aby uniknąć różnic."

msgctxt "Languages::allmarket_sync.secret_reset"
msgid "The key has been changed. Update it in the allmarket.biz cabinet and in your cron."
msgstr "Klucz został zmieniony. Zaktualizuj go w panelu allmarket.biz i w cronie."

