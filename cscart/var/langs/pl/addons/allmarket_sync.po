msgstr "Ceny z zamówienia allmarket.biz"

msgctxt "SettingsTooltips::allmarket_sync::use_am_prices"
msgid "Off — the order uses the current store prices."
msgstr "Wyłączone — zamówienie używa bieżących cen sklepu."

msgctxt "SettingsOptions::allmarket_sync::use_am_shipping"
