msgstr "Metoda dostawy"

msgctxt "SettingsTooltips::allmarket_sync::shipping_id"
msgid "The delivery details from allmarket.biz (city, warehouse) go to the order address and notes."
msgstr "Dane dostawy z allmarket.biz (miasto, oddział) trafiają do adresu i uwag zamówienia."

msgctxt "SettingsOptions::allmarket_sync::payment_id"
