msgctxt "Addons::name::allmarket_sync"
msgid "allmarket.biz Sync"
msgstr "Synchronizacja z allmarket.biz"

msgctxt "Addons::description::allmarket_sync"
msgid "Exchange with the allmarket.biz marketplace: catalog with categories and variations, prices and stock, orders and statuses (Seller API or XML feed)."
msgstr "Wymiana z marketplace allmarket.biz: katalog z kategoriami i wariantami, ceny i stany, zamówienia i statusy (Seller API lub feed XML)."

msgctxt "Languages::allmarket_sync"
msgid "allmarket.biz"
msgstr "allmarket.biz"

msgctxt "Languages::allmarket_sync_menu_description"
msgid "Exchange of the catalog and orders with the allmarket.biz marketplace"
msgstr "Wymiana katalogu i zamówień z marketplace allmarket.biz"

msgctxt "Languages::allmarket_sync_manage"
msgid "Exchange"
msgstr "Wymiana"

msgctxt "Languages::allmarket_sync_manage_menu_description"
msgid "Connection, tasks, orders and log"
msgstr "Połączenie, zadania, zamówienia i dziennik"

