msgstr "Wyślij katalog na allmarket.biz zaraz po zapisaniu"

msgctxt "Languages::allmarket_sync.follows_parent"
msgid "— follows the parent —"
msgstr "— jak nadrzędna —"

msgctxt "Languages::allmarket_sync.not_found_on_portal"
msgid "not found on allmarket.biz"
msgstr "nie znaleziono na allmarket.biz"

msgctxt "Languages::allmarket_sync.settings_info"
msgid "Tasks, URLs for the allmarket.biz cabinet, status mapping, orders and the log are on the add-on page."
msgstr "Zadania, adresy dla panelu allmarket.biz, mapowanie statusów, zamówienia i dziennik są na stronie modułu."

