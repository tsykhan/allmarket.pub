msgctxt "SettingsOptions::allmarket_sync::currency"
msgid "Price currency"
msgstr "Валюта цен"

msgctxt "SettingsTooltips::allmarket_sync::currency"
msgid "Prices are converted from the primary currency at the store rate. Use the same currency as in the allmarket.biz cabinet."
msgstr "Цены пересчитываются из основной валюты по курсу магазина. Используйте ту же валюту, что и в кабинете allmarket.biz."

msgctxt "SettingsOptions::allmarket_sync::categories"
msgid "Export only categories (IDs)"
msgstr "Выгружать только категории (ID)"

msgctxt "SettingsTooltips::allmarket_sync::categories"
msgid "Comma-separated category IDs, subcategories included. Empty — the whole catalog."
msgstr "ID категорий через запятую, вместе с подкатегориями. Пусто — весь каталог."

msgctxt "SettingsOptions::allmarket_sync::variations"
msgid "Export variations as separate offers"
msgstr "Выгружать вариации отдельными предложениями"

msgctxt "SettingsTooltips::allmarket_sync::variations"
msgid "Variations of one product share group_id and carry their variation features. Off — only parent products."
msgstr "Вариации одного товара имеют общий group_id и свои характеристики вариации. Выключено — только родительские товары."

msgctxt "SettingsOptions::allmarket_sync::only_in_stock"
msgid "Only products available for order"
msgstr "Только товары, доступные для заказа"

msgctxt "SettingsOptions::allmarket_sync::price_markup"
msgid "Price markup, %"
msgstr "Наценка на цены, %"

msgctxt "SettingsTooltips::allmarket_sync::price_markup"
msgid "Applied to the price and the old price. Negative value — a discount."
msgstr "Применяется к цене и старой цене. Отрицательное значение — скидка."

msgctxt "SettingsOptions::allmarket_sync::batch_size"
msgid "Products per request"
msgstr "Товаров в запросе"

msgctxt "SettingsOptions::allmarket_sync::orders_enabled"
msgid "Import orders"
msgstr "Импортировать заказы"

msgctxt "SettingsOptions::allmarket_sync::status_new"
msgid "Status of a new order"
msgstr "Статус нового заказа"

msgctxt "SettingsOptions::allmarket_sync::status_paid"
msgid "Status of a paid order"
msgstr "Статус оплаченного заказа"

msgctxt "SettingsOptions::allmarket_sync::shipping_id"
msgid "Shipping method"
msgstr "Способ доставки"

msgctxt "SettingsTooltips::allmarket_sync::shipping_id"
msgid "The delivery details from allmarket.biz (city, warehouse) go to the order address and notes."
msgstr "Данные доставки с allmarket.biz (город, отделение) записываются в адрес и комментарий заказа."

msgctxt "SettingsOptions::allmarket_sync::payment_id"
