msgctxt "Languages::allmarket_sync.mode_inside"
msgid "Create inside"
msgstr "Создать внутри"

msgctxt "Languages::allmarket_sync.send_now"
msgid "Send the catalog to allmarket.biz right after saving"
msgstr "Отправить каталог на allmarket.biz сразу после сохранения"

msgctxt "Languages::allmarket_sync.follows_parent"
msgid "— follows the parent —"
msgstr "— как у родительской —"

msgctxt "Languages::allmarket_sync.not_found_on_portal"
msgid "not found on allmarket.biz"
msgstr "не найдено на allmarket.biz"

msgctxt "Languages::allmarket_sync.settings_info"
msgid "Tasks, URLs for the allmarket.biz cabinet, status mapping, orders and the log are on the add-on page."
msgstr "Задачи, адреса для кабинета allmarket.biz, соответствие статусов, заказы и журнал — на странице модуля."

