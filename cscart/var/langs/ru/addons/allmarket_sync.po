msgctxt "Addons::name::allmarket_sync"
msgid "allmarket.biz Sync"
msgstr "Обмен с allmarket.biz"

msgctxt "Addons::description::allmarket_sync"
msgid "Exchange with the allmarket.biz marketplace: catalog with categories and variations, prices and stock, orders and statuses (Seller API or XML feed)."
msgstr "Обмен с маркетплейсом allmarket.biz: каталог с категориями и вариациями, цены и остатки, заказы и статусы (Seller API или XML-фид)."

msgctxt "Languages::allmarket_sync"
msgid "allmarket.biz"
msgstr "allmarket.biz"

msgctxt "Languages::allmarket_sync_menu_description"
msgid "Exchange of the catalog and orders with the allmarket.biz marketplace"
msgstr "Обмен каталогом и заказами с маркетплейсом allmarket.biz"

msgctxt "Languages::allmarket_sync_manage"
msgid "Exchange"
msgstr "Обмен"

msgctxt "Languages::allmarket_sync_manage_menu_description"
msgid "Connection, tasks, orders and log"
msgstr "Подключение, задачи, заказы и журнал"

msgctxt "Languages::allmarket_sync_categories"
msgid "Category placement"
msgstr "Размещение категорий"

msgctxt "Languages::allmarket_sync_categories_menu_description"
msgid "Where shop categories go on allmarket.biz"
msgstr "Куда попадают категории магазина на allmarket.biz"

msgctxt "Languages::allmarket_sync.task_done"
msgid "Task [task] finished: [stats]"
msgstr "Задача [task] выполнена: [stats]"

msgctxt "Languages::allmarket_sync.ping_ok"
msgid "Connected: [name] (ID [id]), seller currency on the portal: [currency]"
msgstr "Соединение установлено: [name] (ID [id]), валюта продавца на портале: [currency]"

msgctxt "Languages::allmarket_sync.currency_mismatch"
msgid "Your seller currency on allmarket.biz is [portal], while the add-on exports prices in [shop]. The portal converts them at its rate; set the same currency to avoid differences."
msgstr "Валюта продавца на allmarket.biz — [portal], а модуль выгружает цены в [shop]. Портал пересчитает их по своему курсу; чтобы избежать расхождений, установите одинаковую валюту."

msgctxt "Languages::allmarket_sync.secret_reset"
msgid "The key has been changed. Update it in the allmarket.biz cabinet and in your cron."
msgstr "Ключ изменён. Обновите его в кабинете allmarket.biz и в cron."

